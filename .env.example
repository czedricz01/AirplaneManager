# Copy this file to .env for local development.
#
# Only variables prefixed with VITE_ reach the browser, and anything that reaches
# the browser is public. Never put a real secret in a VITE_ variable.

# Supabase project, for accounts and cloud savegames.
# Found in your Supabase project under Settings -> API.
# Leave both empty to run the game without accounts; savegames then stay in this
# browser only.
#
# The anon key is a PUBLIC identifier, not a password. What protects player data
# is Row Level Security in the database — see supabase/schema.sql. Never put the
# service_role key here: that one bypasses every policy.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Set to "true" to turn off Vite hot module reloading during development.
# DISABLE_HMR="true"
