# Copy this file to .env and fill in the values you need.
# Everything here is OPTIONAL — without it the game runs in offline mode.
#
# Only variables prefixed with VITE_ reach the browser, and anything that reaches
# the browser is public. Never put a secret in a VITE_ variable.

# Supabase account login (optional).
# Found in your Supabase project under Settings -> API.
# Leave both empty to play offline; the "Play Offline" button is always available.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Set to "true" to turn off Vite hot module reloading during development.
# DISABLE_HMR="true"
